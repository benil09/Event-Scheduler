PORT=8000
NODE_ENV=development
SLOT_GENERATION_DAYS=30

# ---- For LOCAL dev (npm run dev): use localhost ----
# ---- For DOCKER / EC2: use container service names ----

# Local:   postgresql://nil:Nilkamal09@localhost:5432/calenderly-db?schema=public
# Docker:  postgresql://nil:Nilkamal09@postgres:5432/calenderly-db?schema=public
DATABASE_URL=postgresql://nil:Nilkamal09@localhost:5432/calenderly-db?schema=public

# Local:   redis://127.0.0.1:6379
# Docker:  redis://redis:6379
REDIS_URI=redis://127.0.0.1:6379

# Local:   localhost:7233
# Docker:  temporal:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=event-scheduler-task
TEMPORAL_ENABLED=true

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local:   http://localhost:8000/api/integrations/google/callback
# EC2:     http://<EC2-IP>:8000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_SENDER_EMAIL=your-email@gmail.com
GOOGLE_CALENDAR_ID=primary

# Frontend URL — used by Google OAuth to redirect after login
# Local:   http://localhost:5173
# EC2:     http://<EC2-IP>:5173  (or your deployed frontend URL)
FRONTEND_URL=http://localhost:5173

