apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: event-scheduler
type: Opaque
stringData:
  # Azure Managed PostgreSQL
  DATABASE_URL: "postgresql://<DB_USER>:<DB_PASSWORD>@<PG_SERVER>.postgres.database.azure.com:5432/<DB_NAME>?sslmode=require"
  
  # Temporal Persistence & Visibility on Azure PostgreSQL
  TEMPORAL_DB_URL: "postgresql://<DB_USER>:<DB_PASSWORD>@<PG_SERVER>.postgres.database.azure.com:5432/temporal?sslmode=require"
  TEMPORAL_VISIBILITY_DB_URL: "postgresql://<DB_USER>:<DB_PASSWORD>@<PG_SERVER>.postgres.database.azure.com:5432/temporal_visibility?sslmode=require"

  # Google OAuth & Calendar
  GOOGLE_CLIENT_ID: "<YOUR_GOOGLE_CLIENT_ID>"
  GOOGLE_CLIENT_SECRET: "<YOUR_GOOGLE_CLIENT_SECRET>"
  GOOGLE_REFRESH_TOKEN: "<YOUR_GOOGLE_REFRESH_TOKEN>"

  # SMTP Credentials
  SMTP_USER: "<YOUR_SMTP_EMAIL>"
  SMTP_PASSWORD: "<YOUR_SMTP_APP_PASSWORD>"
